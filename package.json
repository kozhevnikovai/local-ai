{
  "name": "@kozhevnikovai/local-ai",
  "version": "0.3.0",
  "description": "Общий движок локальных ИИ-моделей: каталог «лёгкая/мощная», выбор по железу, загрузка с докачкой и SHA-256, ответы по JSON-схеме через llama.cpp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "llm",
    "local",
    "offline",
    "llama.cpp",
    "gguf",
    "russian",
    "gigachat",
    "qwen",
    "gemma"
  ],
  "author": "Egor Kozhevnikov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozhevnikovai/local-ai.git"
  },
  "peerDependencies": {
    "node-llama-cpp": "^3.22.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "node-llama-cpp": "^3.22.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
